#!/usr/bin/env bash
# bdx-linear-reconcile — field-partitioned Linear -> Beads reconciliation.

set -euo pipefail
umask 077

MIN_BD_VERSION="1.2.2"
API_URL="${BDX_LINEAR_API_URL:-https://api.linear.app/graphql}"
PAGE_LIMIT=1000

die() {
  printf 'bdx-linear: %s\n' "$*" >&2
  exit 2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

usage() {
  cat >&2 <<'EOF'
usage:
  bdx-linear reconcile plan [--agent-home <path>]
  bdx-linear reconcile once --yes [--agent-home <path>]
  bdx-linear reconcile loop --yes [--interval <seconds>] [--agent-home <path>]
  bdx-linear inbox <bd-id> [--json] [--mark-read] [--agent-home <path>]

The reconciler reads Linear directly and updates only already-linked beads.
Linear owns title, priority, and coordination status. Description, assignee,
comments, and other remote context are cached for agents but never overwrite
bdx artifacts, dependency edges, descriptions, or agent assignees.
EOF
}

version_at_least() {
  local current="$1" required="$2"
  awk -v current="$current" -v required="$required" 'BEGIN {
    split(current, c, "."); split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      if ((c[i] + 0) > (r[i] + 0)) exit 0
      if ((c[i] + 0) < (r[i] + 0)) exit 1
    }
    exit 0
  }'
}

require_supported_bd() {
  local raw version
  raw=$(bd version 2>/dev/null || true)
  version=$(printf '%s' "$raw" | sed -nE 's/^bd version ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)
  if [ -z "$version" ] || ! version_at_least "$version" "$MIN_BD_VERSION"; then
    die "bd ${version:-unknown} cannot run reconciliation; requires >= $MIN_BD_VERSION"
  fi
}

config_get() {
  bd config get "$1" 2>/dev/null || true
}

load_scope() {
  AGENT_HOME_VALUE="$1"
  TEAM_ID=$(config_get linear.team_id)
  PROJECT_ID=$(config_get linear.project_id)
  LINEAR_KEY="${LINEAR_API_KEY:-}"
  [ -n "$LINEAR_KEY" ] || LINEAR_KEY=$(config_get linear.api_key)
  [ -n "$LINEAR_KEY" ] || die "Linear API key is not configured"
  [ -n "$TEAM_ID" ] || die "linear.team_id is not configured"

  DATABASE_ID=$(bd info 2>/dev/null | sed -n 's/^Database: //p' | head -n 1)
  [ -n "$DATABASE_ID" ] || DATABASE_ID="unknown-database"
  SCOPE_FINGERPRINT=$(printf '%s\n%s\n%s\n%s\n' \
    "$DATABASE_ID" "$TEAM_ID" "$PROJECT_ID" "$API_URL" | cksum | awk '{print $1}')
  STATE_ROOT="$AGENT_HOME_VALUE/.state/linear/$SCOPE_FINGERPRINT"
  CURSOR_FILE="$STATE_ROOT/cursor.json"
}

utc_now() {
  date -u '+%Y-%m-%dT%H:%M:%S.000Z'
}

file_checksum() {
  cksum "$1" | awk '{print $1 ":" $2}'
}

scope_lock_acquire() {
  local lock="$STATE_ROOT/.lock" lock_pid lock_host current_host
  mkdir -p "$STATE_ROOT"
  current_host=$(hostname)
  if mkdir "$lock" 2>/dev/null; then
    printf '%s\n' "$$" > "$lock/pid"
    printf '%s\n' "$current_host" > "$lock/host"
    date '+%s' > "$lock/started"
    LOCK_DIR="$lock"
    return 0
  fi

  lock_pid=$(sed -n '1p' "$lock/pid" 2>/dev/null || true)
  lock_host=$(sed -n '1p' "$lock/host" 2>/dev/null || true)
  if [ "$lock_host" = "$current_host" ]; then
    if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
      die "reconciliation is already running for this scope (pid $lock_pid)"
    fi
  else
    die "reconciliation lock belongs to host ${lock_host:-unknown}; verify that runner is stopped before manually removing $lock"
  fi
  rm -f "$lock/pid" "$lock/host" "$lock/started"
  rmdir "$lock" 2>/dev/null || die "could not clear stale reconciliation lock"
  mkdir "$lock" || die "could not acquire reconciliation lock"
  printf '%s\n' "$$" > "$lock/pid"
  printf '%s\n' "$current_host" > "$lock/host"
  date '+%s' > "$lock/started"
  LOCK_DIR="$lock"
}

scope_lock_release() {
  [ -n "${LOCK_DIR:-}" ] || return 0
  rm -f "$LOCK_DIR/pid" "$LOCK_DIR/host" "$LOCK_DIR/started"
  rmdir "$LOCK_DIR" 2>/dev/null || true
  LOCK_DIR=""
}

graphql_request() {
  local query="$1" variables="$2" output="$3" payload
  payload=$(jq -cn --arg query "$query" --argjson variables "$variables" \
    '{query:$query,variables:$variables}')
  curl -fsS "$API_URL" \
    -H "@$HEADER_FILE" \
    --connect-timeout 10 \
    --max-time 60 \
    --data "$payload" > "$output"
  if ! jq -e '(.errors == null or (.errors | length == 0)) and (.data != null)' "$output" >/dev/null; then
    jq -r '.errors // "invalid Linear GraphQL response"' "$output" >&2 || true
    return 1
  fi
}

fetch_connection() {
  local resource="$1" query="$2" filter="$3" output="$4" tmp="$5"
  local after_json=null page=0 response="$tmp/$resource-response.json"
  : > "$output"
  while :; do
    page=$((page + 1))
    [ "$page" -le "$PAGE_LIMIT" ] || die "$resource pagination exceeded $PAGE_LIMIT pages"
    variables=$(jq -cn --argjson filter "$filter" --argjson after "$after_json" \
      '{filter:$filter,after:$after}')
    graphql_request "$query" "$variables" "$response" || return 1
    jq -c ".data.$resource.nodes[]" "$response" >> "$output"
    if [ "$(jq -r ".data.$resource.pageInfo.hasNextPage" "$response")" != true ]; then
      break
    fi
    after_json=$(jq -c ".data.$resource.pageInfo.endCursor" "$response")
    [ "$after_json" != null ] || die "$resource response omitted pagination cursor"
  done
}

build_link_map() {
  local local_json="$1" map_json="$2"
  bd list --all --limit 0 --json > "$local_json"
  jq '
    def identifier:
      if test("^linear:[A-Z][A-Z0-9]*-[0-9]+$") then sub("^linear:"; "")
      elif test("/issue/[A-Z][A-Z0-9]*-[0-9]+(/|$)")
        then capture("/issue/(?<id>[A-Z][A-Z0-9]*-[0-9]+)(/|$)").id
      else empty end;
    [ .[]
      | select(.external_ref != null and .external_ref != "")
      | if (.id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) then .
        else error("bead ID cannot be used as a cache key: \(.id)") end
      | (.external_ref | identifier) as $identifier
      | {key:$identifier,value:{
          bd_id:.id,
          title:(.title // ""),
          priority:(.priority // 4),
          status:(.status // "open"),
          external_ref:.external_ref
        }}
    ] as $links
    | ($links | sort_by(.key) | group_by(.key) | map(select(length > 1) | .[0].key)) as $duplicates
    | if ($duplicates | length) > 0
      then error("duplicate Linear external_ref identifiers: \($duplicates | join(", "))")
      else ($links | from_entries)
      end
  ' "$local_json" > "$map_json"
}

make_comment_filter() {
  local since="$1" until="$2" issue_ids="$3"
  COMMENT_FILTER=$(jq -cn \
    --argjson issue_ids "$issue_ids" --arg since "$since" --arg until "$until" '
      {issue:{id:{in:$issue_ids}},updatedAt:{gte:$since,lt:$until}}')
}

fetch_linked_issues() {
  local identifiers="$1" output="$2" tmp="$3"
  local identifier query response batch_index=0 alias_index=0
  local fields='id identifier title description priority updatedAt archivedAt url state { name type } assignee { id name } team { id } project { id }'
  : > "$output"
  query='query {'
  while IFS= read -r identifier || [ -n "$identifier" ]; do
    [ -n "$identifier" ] || continue
    query="$query i$alias_index: issue(id: \"$identifier\") { $fields }"
    alias_index=$((alias_index + 1))
    if [ $((alias_index % 50)) -eq 0 ]; then
      query="$query }"
      response="$tmp/issues-response-$batch_index.json"
      graphql_request "$query" '{}' "$response"
      jq -c '.data[] | select(. != null)' "$response" >> "$output"
      batch_index=$((batch_index + 1))
      query='query {'
    fi
  done < "$identifiers"
  if [ $((alias_index % 50)) -ne 0 ]; then
    query="$query }"
    response="$tmp/issues-response-$batch_index.json"
    graphql_request "$query" '{}' "$response"
    jq -c '.data[] | select(. != null)' "$response" >> "$output"
  fi
}

fetch_linked_comments() {
  local issue_ids="$1" since="$2" until="$3" output="$4" tmp="$5" suffix="$6"
  if [ "$(jq 'length' <<<"$issue_ids")" -eq 0 ]; then
    : > "$output"
    return 0
  fi
  mkdir -p "$tmp/$suffix"
  make_comment_filter "$since" "$until" "$issue_ids"
  fetch_connection comments "$COMMENT_QUERY" "$COMMENT_FILTER" "$output" "$tmp/$suffix"
}

apply_issue_changes() {
  local actions="$1" apply="$2" action bd_id identifier
  local local_status remote_status title_changed priority_changed remote_title remote_priority
  while IFS= read -r action || [ -n "$action" ]; do
    [ -n "$action" ] || continue
    bd_id=$(printf '%s' "$action" | jq -r '.bd_id')
    identifier=$(printf '%s' "$action" | jq -r '.identifier')
    local_status=$(printf '%s' "$action" | jq -r '.local.status')
    remote_status=$(printf '%s' "$action" | jq -r '.remote.status')
    title_changed=$(printf '%s' "$action" | jq -r '.title_changed')
    priority_changed=$(printf '%s' "$action" | jq -r '.priority_changed')
    remote_title=$(printf '%s' "$action" | jq -r '.remote.title')
    remote_priority=$(printf '%s' "$action" | jq -r '.remote.priority')

    printf '  %s (%s): status %s -> %s, title=%s, priority=%s\n' \
      "$bd_id" "$identifier" "$local_status" "$remote_status" "$title_changed" "$priority_changed"
    [ "$apply" = true ] || continue

    if [ "$remote_status" = closed ]; then
      if [ "$local_status" != closed ]; then
        bd close "$bd_id" --reason "Closed in Linear ($identifier)" >/dev/null
      fi
    else
      if [ "$local_status" = closed ]; then
        bd reopen "$bd_id" --reason "Reopened in Linear ($identifier)" >/dev/null
        local_status=open
      fi
      if [ "$local_status" != "$remote_status" ]; then
        bd update "$bd_id" --status "$remote_status" >/dev/null
      fi
    fi

    update_args=("$bd_id")
    if [ "$title_changed" = true ]; then
      update_args+=(--title "$remote_title")
    fi
    if [ "$priority_changed" = true ]; then
      update_args+=(--priority "$remote_priority")
    fi
    if [ "${#update_args[@]}" -gt 1 ]; then
      bd update "${update_args[@]}" >/dev/null
    fi
  done < "$actions"
}

stage_comments() {
  local comments="$1" link_map="$2" staged="$3" rollups="$4" apply="$5"
  local file bd_id current empty_object
  mkdir -p "$staged/incoming-by-bead" "$staged/by-bead"
  jq -cn --slurpfile links "$link_map" '
    $links[0] as $links
    | inputs
    | .issue.identifier as $identifier
    | select($links[$identifier] != null)
    | $links[$identifier].bd_id as $bd_id
    | {
        id,bd_id:$bd_id,issue_identifier:$identifier,body,
        createdAt,updatedAt,archivedAt,url,
        author:(.user.name // .externalUser.name // "Unknown")
      }
  ' "$comments" > "$staged/incoming.ndjson"
  jq -r '.bd_id + "\t" + (tojson)' "$staged/incoming.ndjson" |
    awk -F '\t' -v dir="$staged/incoming-by-bead" '{ key=$1; sub(/^[^\t]*\t/, ""); print > (dir "/" key ".ndjson") }'

  empty_object="$staged/empty-object.json"
  printf '{}\n' > "$empty_object"
  : > "$rollups"
  for file in "$staged/incoming-by-bead"/*.ndjson; do
    [ -e "$file" ] || continue
    bd_id=$(basename "$file" .ndjson)
    current="$STATE_ROOT/comments/$bd_id.json"
    [ -f "$current" ] || current="$empty_object"
    jq -cn --slurpfile current "$current" '
      $current[0] as $current
      | inputs
      | . as $record
      | ($current[$record.id] // null) as $previous
      | select($previous == null or
          ($previous | {id,bd_id,issue_identifier,body,createdAt,updatedAt,archivedAt,url,author}) != $record)
      | $record + {version:(($previous.version // 0) + 1),unread:true}
    ' "$file" > "$staged/by-bead/$bd_id.ndjson"
    jq -r '.bd_id' "$staged/by-bead/$bd_id.ndjson" >> "$rollups"
  done
  [ "$apply" = true ] || return 0
}

post_comment_rollups() {
  local rollups="$1" apply="$2" bd_id count
  [ -s "$rollups" ] || return 0
  sort "$rollups" | uniq -c | while read -r count bd_id; do
    printf '  %s: %s new/updated Linear comment(s)\n' "$bd_id" "$count"
    if [ "$apply" = true ]; then
      bd comment "$bd_id" "linear inbox: $count new/updated comment(s); run 'bdx-linear inbox $bd_id'" >/dev/null
    fi
  done
}

commit_state() {
  local tmp="$1" run_until="$2" link_fingerprint="$3" linked_identifiers="$4" bootstrapped_identifiers="$5"
  local file cursor_tmp bd_id current merged empty_object
  mkdir -p "$STATE_ROOT/issues" "$STATE_ROOT/comments"
  for file in "$tmp/staged/issues"/*.json; do
    [ -e "$file" ] || continue
    mv -f "$file" "$STATE_ROOT/issues/$(basename "$file")"
  done
  empty_object="$tmp/empty-object.json"
  printf '{}\n' > "$empty_object"
  for file in "$tmp/staged/comments/by-bead"/*.ndjson; do
    [ -s "$file" ] || continue
    bd_id=$(basename "$file" .ndjson)
    current="$STATE_ROOT/comments/$bd_id.json"
    [ -f "$current" ] || current="$empty_object"
    merged=$(mktemp "$STATE_ROOT/comments/$bd_id.tmp.XXXXXX")
    jq -s --slurpfile current "$current" '
      reduce .[] as $record ($current[0]; .[$record.id] = $record)
    ' "$file" > "$merged"
    mv -f "$merged" "$STATE_ROOT/comments/$bd_id.json"
  done
  cursor_tmp=$(mktemp "$STATE_ROOT/cursor.json.tmp.XXXXXX")
  jq -cn \
    --arg team_id "$TEAM_ID" --arg project_id "$PROJECT_ID" \
    --arg database_id "$DATABASE_ID" --arg api_url "$API_URL" \
    --arg issues_observed_at "$run_until" --arg comments_after "$run_until" \
    --arg link_fingerprint "$link_fingerprint" \
    --slurpfile linked_identifiers "$linked_identifiers" \
    --slurpfile bootstrapped_identifiers "$bootstrapped_identifiers" '
      {
        schema:1,
        scope:{team_id:$team_id,project_id:$project_id,database_id:$database_id,api_url:$api_url},
        issues_observed_at:$issues_observed_at,
        comments_after:$comments_after,
        link_fingerprint:$link_fingerprint,
        linked_identifiers:$linked_identifiers[0],
        comment_bootstrapped_identifiers:$bootstrapped_identifiers[0]
      }' > "$cursor_tmp"
  mv -f "$cursor_tmp" "$CURSOR_FILE"
}

reconcile_once() {
  local apply="$1" agent_home="$2" tmp run_until issue_since comment_since link_fingerprint
  local all_issue_ids new_issue_ids
  load_scope "$agent_home"
  require_supported_bd
  need jq; need curl; need cksum

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/bdx-linear-reconcile.XXXXXX")
  RECONCILE_TMP="$tmp"
  HEADER_FILE="$tmp/linear.headers"
  printf 'Authorization: %s\nContent-Type: application/json\n' "$LINEAR_KEY" > "$HEADER_FILE"
  trap 'scope_lock_release; rm -rf "$RECONCILE_TMP"' EXIT INT TERM
  mkdir -p "$tmp/staged/issues" "$tmp/staged/comments"
  if [ "$apply" = true ]; then
    scope_lock_acquire
  fi

  build_link_map "$tmp/local.json" "$tmp/link-map.json"
  jq -r 'keys[]' "$tmp/link-map.json" > "$tmp/linked-identifiers"
  jq 'keys' "$tmp/link-map.json" > "$tmp/linked-identifiers.json"
  link_fingerprint=$(file_checksum "$tmp/linked-identifiers")
  issue_since="1970-01-01T00:00:00.000Z"
  comment_since="$issue_since"
  if [ -f "$CURSOR_FILE" ]; then
    issue_since=$(jq -r '.issues_observed_at // .issues_after // "1970-01-01T00:00:00.000Z"' "$CURSOR_FILE")
    comment_since=$(jq -r '.comments_after // "1970-01-01T00:00:00.000Z"' "$CURSOR_FILE")
  fi
  run_until=$(utc_now)

  COMMENT_QUERY='query($filter: CommentFilter, $after: String) { comments(filter: $filter, first: 50, after: $after, includeArchived: true) { nodes { id body createdAt updatedAt archivedAt url user { name } externalUser { name } issue { id identifier } } pageInfo { hasNextPage endCursor } } }'

  fetch_linked_issues "$tmp/linked-identifiers" "$tmp/issues-all.ndjson" "$tmp"
  jq -c --arg team "$TEAM_ID" --arg project "$PROJECT_ID" '
    select(.team.id == $team and ($project == "" or .project.id == $project))
  ' "$tmp/issues-all.ndjson" > "$tmp/issues.ndjson"
  all_issue_ids=$(jq -sc 'map(.id) | unique' "$tmp/issues.ndjson")
  jq -sc 'map(.identifier) | unique' "$tmp/issues.ndjson" > "$tmp/resolved-identifiers.json"

  if [ -f "$CURSOR_FILE" ]; then
    jq '.comment_bootstrapped_identifiers // .linked_identifiers // []' "$CURSOR_FILE" > "$tmp/previous-identifiers.json"
  else
    printf '[]\n' > "$tmp/previous-identifiers.json"
  fi
  jq -n --slurpfile current "$tmp/resolved-identifiers.json" --slurpfile previous "$tmp/previous-identifiers.json" '
    $current[0] - $previous[0]
  ' > "$tmp/new-identifiers.json"
  new_issue_ids=$(jq -sc --slurpfile identifiers "$tmp/new-identifiers.json" '
    ($identifiers[0]) as $new | map(select(.identifier as $id | $new | index($id))) | map(.id) | unique
  ' "$tmp/issues.ndjson")

  fetch_linked_comments "$all_issue_ids" "$comment_since" "$run_until" "$tmp/comments-incremental.ndjson" "$tmp" incremental
  if [ "$comment_since" != '1970-01-01T00:00:00.000Z' ] && [ "$(jq 'length' <<<"$new_issue_ids")" -gt 0 ]; then
    fetch_linked_comments "$new_issue_ids" '1970-01-01T00:00:00.000Z' "$run_until" "$tmp/comments-bootstrap.ndjson" "$tmp" bootstrap
  else
    : > "$tmp/comments-bootstrap.ndjson"
  fi
  jq -sc 'group_by(.id) | map(max_by(.updatedAt))[]' \
    "$tmp/comments-incremental.ndjson" "$tmp/comments-bootstrap.ndjson" > "$tmp/comments.ndjson"

  jq -cn --slurpfile links "$tmp/link-map.json" '
    $links[0] as $links
    | inputs
    | select($links[.identifier] != null)
    | $links[.identifier] as $local
    | (if .priority == 0 then 4 elif .priority == 1 then 0 elif .priority == 2 then 1 elif .priority == 3 then 2 elif .priority == 4 then 3 else 4 end) as $priority
    | (if .archivedAt != null or .state.type == "completed" or .state.type == "canceled" then "closed"
       elif .state.type == "started" then "in_progress" else "open" end) as $status
    | {
        bd_id:$local.bd_id,identifier,
        local:$local,
        remote:{title,priority:$priority,status:$status},
        title_changed:($local.title != .title),
        priority_changed:($local.priority != $priority),
        status_changed:($local.status != $status),
        issue:.
      }
  ' "$tmp/issues.ndjson" > "$tmp/actions.ndjson"

  while IFS= read -r action || [ -n "$action" ]; do
    [ -n "$action" ] || continue
    bd_id=$(printf '%s' "$action" | jq -r '.bd_id')
    printf '%s' "$action" | jq --arg bd_id "$bd_id" '.issue + {bd_id:$bd_id}' > "$tmp/staged/issues/$bd_id.json"
  done < "$tmp/actions.ndjson"

  printf 'Linear reconciliation %s\n' "$(if [ "$apply" = true ]; then printf apply; else printf preview; fi)"
  printf '  scope      team=%s project=%s\n' "$TEAM_ID" "${PROJECT_ID:-all}"
  printf '  linked     %s bead(s)\n' "$(jq 'length' "$tmp/link-map.json")"
  printf '  issue snapshot  previous=%s current=%s\n' "$issue_since" "$run_until"
  printf '  comment window  %s .. %s\n' "$comment_since" "$run_until"
  printf '\nIssue changes:\n'
  apply_issue_changes "$tmp/actions.ndjson" "$apply"

  stage_comments "$tmp/comments.ndjson" "$tmp/link-map.json" "$tmp/staged/comments" "$tmp/rollups" "$apply"
  printf '\nComment inbox changes:\n'
  post_comment_rollups "$tmp/rollups" "$apply"

  if [ "$apply" = true ]; then
    commit_state "$tmp" "$run_until" "$link_fingerprint" \
      "$tmp/linked-identifiers.json" "$tmp/resolved-identifiers.json"
    printf '\nReconciliation applied; cursor advanced after all local writes.\n'
  else
    printf '\nPreview complete; no local state or cursor was written.\n'
  fi
  scope_lock_release
  rm -rf "$tmp"
  trap - EXIT INT TERM
}

reconcile_command() {
  local action="${1:-}" yes=false interval=120 agent_home="${AGENT_HOME:-$HOME/.bdx-agent}"
  [ -n "$action" ] || die "reconcile requires plan, once, or loop"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=true; shift ;;
      --interval)
        [ "$#" -ge 2 ] || die "--interval requires seconds"
        interval="$2"; shift 2 ;;
      --agent-home)
        [ "$#" -ge 2 ] || die "--agent-home requires a path"
        agent_home="$2"; shift 2 ;;
      -h|--help) usage; return 0 ;;
      *) die "unknown reconcile option: $1" ;;
    esac
  done
  case "$action" in
    plan)
      [ "$yes" = false ] || die "--yes is valid only with reconcile once or loop"
      reconcile_once false "$agent_home"
      ;;
    once)
      [ "$yes" = true ] || die "reconcile once requires --yes"
      reconcile_once true "$agent_home"
      ;;
    loop)
      [ "$yes" = true ] || die "reconcile loop requires --yes"
      [[ "$interval" =~ ^[0-9]+$ ]] || die "--interval must be an integer"
      [ "$interval" -ge 60 ] || die "--interval must be at least 60 seconds"
      while :; do
        reconcile_once true "$agent_home"
        sleep "$interval"
      done
      ;;
    *) die "unknown reconcile action: $action" ;;
  esac
}

inbox_command() {
  local bd_id="${1:-}" json=false mark_read=false agent_home="${AGENT_HOME:-$HOME/.bdx-agent}"
  [ -n "$bd_id" ] || die "inbox requires a bead ID"
  [[ "$bd_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid bead ID: $bd_id"
  shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json|-j) json=true; shift ;;
      --mark-read) mark_read=true; shift ;;
      --agent-home)
        [ "$#" -ge 2 ] || die "--agent-home requires a path"
        agent_home="$2"; shift 2 ;;
      *) die "unknown inbox option: $1" ;;
    esac
  done
  load_scope "$agent_home"
  if [ "$mark_read" = true ]; then
    scope_lock_acquire
  fi
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/bdx-linear-inbox.XXXXXX")
  INBOX_TMP="$tmp"
  trap 'scope_lock_release; rm -rf "$INBOX_TMP"' EXIT INT TERM
  comment_file="$STATE_ROOT/comments/$bd_id.json"
  if [ -f "$comment_file" ]; then
    jq '[.[]] | sort_by(.createdAt,.id)' "$comment_file" > "$tmp/comments.json"
  else
    printf '[]\n' > "$tmp/comments.json"
  fi
  if [ "$json" = true ]; then
    jq '.' "$tmp/comments.json"
  else
    count=$(jq 'length' "$tmp/comments.json")
    printf 'Linear inbox for %s (%s comment(s))\n' "$bd_id" "$count"
    jq -r '.[] | "\n\(if .unread then "*" else " " end) \(.author) · \(.updatedAt)\n\(.body)\n\(.url // "")"' "$tmp/comments.json"
  fi
  if [ "$mark_read" = true ]; then
    if [ -f "$comment_file" ] && jq -e 'any(.[]; .unread == true)' "$comment_file" >/dev/null; then
      updated=$(mktemp "$STATE_ROOT/comments/$bd_id.tmp.XXXXXX")
      jq 'with_entries(.value.unread = false)' "$comment_file" > "$updated"
      mv -f "$updated" "$comment_file"
    fi
  fi
  rm -rf "$tmp"
  scope_lock_release
  trap - EXIT INT TERM
}

command="${1:-}"
[ $# -eq 0 ] || shift
case "$command" in
  reconcile) reconcile_command "$@" ;;
  inbox) inbox_command "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage; die "unknown reconciliation command: $command" ;;
esac

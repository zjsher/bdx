#!/usr/bin/env bash
# bdx-linear — privacy-safe Linear projection for bdx artifacts.

set -euo pipefail

MIN_BD_VERSION="1.2.2"
MAX_SELECTION=100

usage() {
  cat >&2 <<'EOF'
usage:
  bdx-linear status [--json] [--agent-home <path>]
  bdx-linear issues plan <bd-id>... | --tree <parent-id>
  bdx-linear issues apply --yes [--agent-home <path>] <bd-id>...
  bdx-linear reconcile plan|once|loop [options]
  bdx-linear inbox <bd-id> [--json] [--mark-read]

status is read-only. issues plan runs a native bounded dry-run. issues apply
requires --yes, repeats that dry-run, then pushes only the resolved selection.
Empty selection and whole-database push are never allowed.
EOF
}

die() {
  printf 'bdx-linear: %s\n' "$*" >&2
  exit 2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

version_at_least() {
  local current="$1" required="$2"
  awk -v current="$current" -v required="$required" 'BEGIN {
    split(current, c, ".")
    split(required, r, ".")
    for (i = 1; i <= 3; i++) {
      if ((c[i] + 0) > (r[i] + 0)) exit 0
      if ((c[i] + 0) < (r[i] + 0)) exit 1
    }
    exit 0
  }'
}

read_bd_version() {
  BD_RAW_VERSION=$(bd version 2>/dev/null || true)
  BD_VERSION=$(printf '%s' "$BD_RAW_VERSION" | sed -nE 's/^bd version ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)
}

require_mutation_ready() {
  read_bd_version
  if [ -z "$BD_VERSION" ] || ! version_at_least "$BD_VERSION" "$MIN_BD_VERSION"; then
    die "bd ${BD_VERSION:-unknown} cannot mutate Linear; requires >= $MIN_BD_VERSION. Upgrade with: curl -fsSL https://raw.githubusercontent.com/gastownhall/beads/main/scripts/install.sh | bash ; then rerun 'bdx-linear status'."
  fi

  local configured
  configured=$(bd linear status --json 2>/dev/null | jq -r '.configured // false') ||
    die "could not read native Linear configuration"
  [ "$configured" = true ] || die "Linear is not configured; set linear.api_key and linear.team_id first"
}

valid_bd_id() {
  [[ "$1" =~ ^[[:alnum:]][[:alnum:]_.-]*-[[:alnum:]]+$ ]]
}

add_unique_id() {
  local id="$1" output="$2"
  valid_bd_id "$id" || die "invalid bead ID: $id"
  grep -Fqx "$id" "$output" 2>/dev/null || printf '%s\n' "$id" >> "$output"
}

expand_tree() {
  local root="$1" output="$2" queue="$3" current tree_count
  : > "$queue"
  printf '%s\n' "$root" >> "$queue"
  while IFS= read -r current || [ -n "$current" ]; do
    if grep -Fqx "$current" "$output" 2>/dev/null; then
      continue
    fi
    add_unique_id "$current" "$output"
    tree_count=$(wc -l < "$output" | tr -d ' ')
    [ "$tree_count" -le "$MAX_SELECTION" ] ||
      die "tree selection exceeded maximum of $MAX_SELECTION beads"
    if ! bd list --parent "$current" --all --limit 0 --json |
      jq -r 'if type == "array" then .[].id else error("expected array") end' >> "$queue"; then
      die "could not expand child tree for $current"
    fi
  done < "$queue"
}

collect_selection() {
  local output="$1" queue="$2" tree_root="$3"
  shift 3
  : > "$output"
  if [ -n "$tree_root" ]; then
    [ "$#" -eq 0 ] || die "use either explicit bead IDs or --tree, not both"
    valid_bd_id "$tree_root" || die "invalid parent bead ID: $tree_root"
    expand_tree "$tree_root" "$output" "$queue"
  else
    [ "$#" -gt 0 ] || die "select at least one bead ID or one --tree parent"
    local id
    for id in "$@"; do
      add_unique_id "$id" "$output"
    done
  fi

  SELECTION_COUNT=$(wc -l < "$output" | tr -d ' ')
  [ "$SELECTION_COUNT" -gt 0 ] || die "selection resolved to zero beads"
  [ "$SELECTION_COUNT" -le "$MAX_SELECTION" ] ||
    die "selection resolved to $SELECTION_COUNT beads; maximum is $MAX_SELECTION"
}

linear_identifier_from_ref() {
  local ref="$1"
  LINEAR_IDENTIFIER=""
  if [[ "$ref" =~ ^linear:([A-Z][A-Z0-9]*-[0-9]+)$ ]]; then
    LINEAR_IDENTIFIER="${BASH_REMATCH[1]}"
  elif [[ "$ref" =~ ^([A-Z][A-Z0-9]*-[0-9]+)$ ]]; then
    LINEAR_IDENTIFIER="${BASH_REMATCH[1]}"
  elif [[ "$ref" =~ /issue/([A-Z][A-Z0-9]*-[0-9]+)(/|$) ]]; then
    LINEAR_IDENTIFIER="${BASH_REMATCH[1]}"
  fi
  [ -n "$LINEAR_IDENTIFIER" ]
}

mirror_plan_ref() {
  local agent_home="$1" bd_id="$2" identifier="$3" plan tmp plan_mode
  local matches=("$agent_home/plan/$bd_id-"*.md)
  if [ ! -e "${matches[0]}" ]; then
    return 0
  fi
  if [ "${#matches[@]}" -ne 1 ]; then
    printf 'bdx-linear: warning: %s has %s matching plans; external ref not mirrored\n' \
      "$bd_id" "${#matches[@]}" >&2
    return 0
  fi
  plan="${matches[0]}"
  if grep -Fq "linear:$identifier" "$plan"; then
    return 0
  fi

  local external_count=0 external_value="" line first=true in_frontmatter=false
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$first" = true ]; then
      first=false
      [ "$line" = "---" ] || break
      in_frontmatter=true
      continue
    fi
    [ "$in_frontmatter" = true ] || break
    [ "$line" != "---" ] || break
    case "$line" in
      external:*)
        external_count=$((external_count + 1))
        trim_scalar "${line#*:}"
        external_value="$TRIMMED"
        ;;
    esac
  done < "$plan"

  if [ "$external_count" -gt 1 ]; then
    printf 'bdx-linear: warning: %s has duplicate external keys; external ref not mirrored\n' "$plan" >&2
    return 0
  fi
  if [ "$external_count" -eq 1 ] && [ -n "$external_value" ] && [ "$external_value" != "[]" ]; then
    printf 'bdx-linear: warning: %s uses inline external metadata; external ref not mirrored\n' "$plan" >&2
    return 0
  fi

  tmp=$(mktemp "${plan}.tmp.XXXXXX") || return 1
  if ! awk -v ref="linear:$identifier" -v external_count="$external_count" -v external_value="$external_value" '
    BEGIN { in_frontmatter=0; external_block=0; inserted=0 }
    NR == 1 && $0 == "---" { in_frontmatter=1; print; next }
    in_frontmatter && $0 == "---" {
      if (external_block && !inserted) { print "  - \"" ref "\""; inserted=1 }
      if (external_count == 0 && !inserted) {
        print "external:"
        print "  - \"" ref "\""
        inserted=1
      }
      in_frontmatter=0
      print
      next
    }
    in_frontmatter && $0 ~ /^external:[[:space:]]*/ {
      if (external_value == "[]") {
        print "external:"
        print "  - \"" ref "\""
        inserted=1
      } else {
        print
        external_block=1
      }
      next
    }
    in_frontmatter && external_block && $0 ~ /^[^[:space:]]/ {
      if (!inserted) { print "  - \"" ref "\""; inserted=1 }
      external_block=0
    }
    { print }
    END { if (!inserted) exit 3 }
  ' "$plan" > "$tmp"; then
    rm -f "$tmp"
    printf 'bdx-linear: warning: could not safely mirror external ref into %s\n' "$plan" >&2
    return 0
  fi
  plan_mode=$(stat -f '%Lp' "$plan" 2>/dev/null || stat -c '%a' "$plan" 2>/dev/null || true)
  [ -z "$plan_mode" ] || chmod "$plan_mode" "$tmp"
  mv -f "$tmp" "$plan"
  printf 'Mirrored linear:%s into %s\n' "$identifier" "$plan"
}

mirror_applied_refs() {
  local agent_home="$1" id issue_json external_ref
  shift
  for id in "$@"; do
    if ! issue_json=$(bd show "$id" --json 2>/dev/null); then
      printf 'bdx-linear: warning: could not read %s after Linear push\n' "$id" >&2
      continue
    fi
    external_ref=$(printf '%s' "$issue_json" | jq -r '
      (if type == "array" then .[0] else . end) | .external_ref // empty')
    if [ -z "$external_ref" ]; then
      printf 'bdx-linear: warning: %s has no external_ref after Linear push\n' "$id" >&2
      continue
    fi
    if ! linear_identifier_from_ref "$external_ref"; then
      printf 'bdx-linear: warning: %s external_ref is not a recognized Linear reference\n' "$id" >&2
      continue
    fi
    mirror_plan_ref "$agent_home" "$id" "$LINEAR_IDENTIFIER"
  done
}

issues_command() {
  local action="${1:-}" tree_root="" yes=false tmp id agent_home="${AGENT_HOME:-$HOME/.bdx-agent}"
  local requested_ids=() selected_ids=()
  [ -n "$action" ] || die "issues requires plan or apply"
  shift

  case "$action" in
    plan|apply) ;;
    -h|--help|help) usage; return 0 ;;
    *) die "unknown issues action: $action" ;;
  esac

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --tree)
        [ "$#" -ge 2 ] || die "--tree requires one parent bead ID"
        [ -z "$tree_root" ] || die "--tree may be supplied only once"
        tree_root="$2"
        shift 2
        ;;
      --yes) yes=true; shift ;;
      --agent-home)
        [ "$#" -ge 2 ] || die "--agent-home requires a path"
        agent_home="$2"
        shift 2
        ;;
      -h|--help) usage; return 0 ;;
      --*) die "unknown issues option: $1" ;;
      *) requested_ids+=("$1"); shift ;;
    esac
  done

  [ "$action" = apply ] || [ "$yes" = false ] || die "--yes is valid only with issues apply"
  [ "$action" != apply ] || [ "$yes" = true ] || die "issues apply requires --yes after reviewing issues plan"
  [ "$action" != apply ] || [ -z "$tree_root" ] ||
    die "issues apply requires frozen explicit IDs; use the command emitted by issues plan --tree"

  need jq
  need bd
  require_mutation_ready

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/bdx-linear-issues.XXXXXX") || exit 1
  BDX_LINEAR_TMP="$tmp"
  trap 'rm -rf "$BDX_LINEAR_TMP"' EXIT
  collect_selection "$tmp/selection" "$tmp/queue" "$tree_root" "${requested_ids[@]}"
  while IFS= read -r id || [ -n "$id" ]; do
    selected_ids+=("$id")
  done < "$tmp/selection"

  printf 'Selected %s bead(s):\n' "$SELECTION_COUNT"
  sed 's/^/  /' "$tmp/selection"
  printf '\nNative Linear dry-run:\n'
  bd linear push "${selected_ids[@]}" --dry-run

  if [ "$action" = apply ]; then
    printf '\nApplying reviewed selection only:\n'
    bd linear push "${selected_ids[@]}"
    mirror_applied_refs "$agent_home" "${selected_ids[@]}"
  else
    printf '\nPreview complete. Re-run with: bdx-linear issues apply --yes'
    printf ' %s\n' "${selected_ids[*]}"
  fi
}

trim_scalar() {
  TRIMMED="$1"
  SCALAR_QUOTED=false
  TRIMMED="${TRIMMED#"${TRIMMED%%[![:space:]]*}"}"
  TRIMMED="${TRIMMED%"${TRIMMED##*[![:space:]]}"}"
  if [ "${#TRIMMED}" -ge 2 ]; then
    case "$TRIMMED" in
      \"*\") TRIMMED="${TRIMMED#\"}"; TRIMMED="${TRIMMED%\"}"; SCALAR_QUOTED=true ;;
      \'*\') TRIMMED="${TRIMMED#\'}"; TRIMMED="${TRIMMED%\'}"; SCALAR_QUOTED=true ;;
    esac
  fi
  if [ "$SCALAR_QUOTED" = false ]; then
    TRIMMED="${TRIMMED%%#*}"
    TRIMMED="${TRIMMED%"${TRIMMED##*[![:space:]]}"}"
  fi
}

json_escape() {
  JSON_ESCAPED="$1"
  JSON_ESCAPED="${JSON_ESCAPED//\\/\\\\}"
  JSON_ESCAPED="${JSON_ESCAPED//\"/\\\"}"
  JSON_ESCAPED="${JSON_ESCAPED//$'\n'/\\n}"
  JSON_ESCAPED="${JSON_ESCAPED//$'\r'/\\r}"
  JSON_ESCAPED="${JSON_ESCAPED//$'\t'/\\t}"
}

parse_artifact() {
  local kind="$1" path="$2" output="$3"
  local line first=1 in_frontmatter=0 ended=0 bd_count=0 privacy_count=0
  local raw_key normalized_key indented_value frontmatter_syntax_invalid=false indent_allowed=false
  local bd_id="" private="" privacy_quoted=false eligible=false reason=""
  local escaped_kind escaped_path escaped_bd escaped_reason

  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$first" = 1 ]; then
      first=0
      [ "$line" = "---" ] || break
      in_frontmatter=1
      continue
    fi
    [ "$in_frontmatter" = 1 ] || break
    if [ "$line" = "---" ]; then
      ended=1
      break
    fi
    case "$line" in
      ''|'#'*) continue ;;
      [[:space:]]*)
        indented_value="${line#"${line%%[![:space:]]*}"}"
        case "$indented_value" in ''|'#'*) continue ;; esac
        [ "$indent_allowed" = true ] || frontmatter_syntax_invalid=true
        continue
        ;;
    esac
    if [[ "$line" =~ ^[[:alpha:]][[:alnum:]_-]*: ]]; then
      raw_key="${line%%:*}"
      trim_scalar "$raw_key"
      normalized_key="$TRIMMED"
      trim_scalar "${line#*:}"
      case "$TRIMMED" in
        ''|'|'|'|-'|'|+'|'>'|'>-'|'>+') indent_allowed=true ;;
        *) indent_allowed=false ;;
      esac
      case "$normalized_key" in
        bd)
          bd_count=$((bd_count + 1))
          trim_scalar "${line#*:}"
          bd_id="$TRIMMED"
          ;;
        private)
          privacy_count=$((privacy_count + 1))
          trim_scalar "${line#*:}"
          private="$TRIMMED"
          privacy_quoted="$SCALAR_QUOTED"
          ;;
      esac
    else
      frontmatter_syntax_invalid=true
    fi
  done < "$path"

  if [ "$ended" != 1 ]; then
    reason="invalid_frontmatter"
  elif [ "$frontmatter_syntax_invalid" = true ]; then
    reason="noncanonical_frontmatter"
  elif [ "$bd_count" -eq 0 ]; then
    reason="missing_bd"
  elif [ "$bd_count" -ne 1 ]; then
    reason="duplicate_bd"
  elif ! [[ "$bd_id" =~ ^[[:alnum:]][[:alnum:]_.-]*-[[:alnum:]]+$ ]]; then
    reason="invalid_bd"
  elif [ "$privacy_count" -eq 0 ]; then
    reason="missing_privacy"
  elif [ "$privacy_count" -ne 1 ]; then
    reason="duplicate_privacy"
  elif [ "$privacy_quoted" = true ] || [ "$private" != "false" ]; then
    case "$private" in
      true) reason="private" ;;
      *) reason="invalid_privacy" ;;
    esac
  elif [ "$kind" = "context" ]; then
    reason="context_requires_opt_in"
  else
    eligible=true
  fi

  json_escape "$kind"; escaped_kind="$JSON_ESCAPED"
  json_escape "$path"; escaped_path="$JSON_ESCAPED"
  json_escape "$bd_id"; escaped_bd="$JSON_ESCAPED"
  json_escape "$reason"; escaped_reason="$JSON_ESCAPED"
  printf '{"kind":"%s","path":"%s","bd":"%s","eligible":%s,"reason":"%s"}\n' \
    "$escaped_kind" "$escaped_path" "$escaped_bd" "$eligible" "$escaped_reason" >> "$output"
}

discover_dir() {
  local kind="$1" dir="$2" output="$3" path
  [ -d "$dir" ] || return 0
  for path in "$dir"/*.md; do
    [ -e "$path" ] || continue
    parse_artifact "$kind" "$path" "$output"
  done
}

status_command() {
  local json=0 agent_home="${AGENT_HOME:-$HOME/.bdx-agent}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --json|-j) json=1; shift ;;
      --agent-home)
        [ $# -ge 2 ] || die "--agent-home requires a path"
        agent_home="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown status option: $1" ;;
    esac
  done

  need jq
  need bd

  local tmp artifacts_json bd_raw bd_version mutation_ready linear_status linear_available result
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/bdx-linear.XXXXXX") || exit 1
  BDX_LINEAR_TMP="$tmp"
  trap 'rm -rf "$BDX_LINEAR_TMP"' EXIT
  : > "$tmp/artifacts.ndjson"

  discover_dir plan "$agent_home/plan" "$tmp/artifacts.ndjson"
  discover_dir summary "$agent_home/summary" "$tmp/artifacts.ndjson"
  discover_dir context "$agent_home/context" "$tmp/artifacts.ndjson"
  artifacts_json=$(jq -s '.' "$tmp/artifacts.ndjson")

  bd_raw=$(bd version 2>/dev/null || true)
  bd_version=$(printf '%s' "$bd_raw" | sed -nE 's/^bd version ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)
  mutation_ready=false
  if [ -n "$bd_version" ] && version_at_least "$bd_version" "$MIN_BD_VERSION"; then
    mutation_ready=true
  fi

  linear_available=false
  linear_status='{"configured":false,"available":false}'
  if bd linear status --json > "$tmp/linear.json" 2>/dev/null && jq -e 'type == "object"' "$tmp/linear.json" >/dev/null 2>&1; then
    linear_available=true
    linear_status=$(jq '. + {available:true} | del(.api_key)' "$tmp/linear.json")
  fi

  result=$(jq -cn \
    --arg agent_home "$agent_home" \
    --arg raw_version "$bd_raw" \
    --arg version "$bd_version" \
    --arg required "$MIN_BD_VERSION" \
    --argjson mutation_ready "$mutation_ready" \
    --argjson linear_available "$linear_available" \
    --argjson linear "$linear_status" \
    --argjson artifacts "$artifacts_json" '
      {
        agent_home:$agent_home,
        bd:{raw:$raw_version,version:$version,required:$required,mutation_ready:$mutation_ready},
        linear:($linear + {available:$linear_available}),
        artifacts:{
          total:($artifacts|length),
          publishable:[$artifacts[]|select(.eligible)],
          excluded:[$artifacts[]|select(.eligible|not)],
          by_kind:($artifacts|group_by(.kind)|map({key:.[0].kind,value:length})|from_entries),
          exclusions:([$artifacts[]|select(.eligible|not)|.reason]
            | group_by(.)|map({key:.[0],value:length})|from_entries)
        }
      }')

  if [ "$json" = 1 ]; then
    printf '%s\n' "$result" | jq '.'
    return 0
  fi

  printf 'bdx Linear projection status\n\n'
  if [ "$mutation_ready" = true ]; then
    printf '  bd          %s (mutation-compatible)\n' "$bd_version"
  else
    printf '  bd          %s (mutation blocked; requires >= %s)\n' "${bd_version:-unknown}" "$MIN_BD_VERSION"
  fi
  printf '  Linear      %s\n' "$(printf '%s' "$result" | jq -r 'if .linear.available then (if .linear.configured then "configured" else "not configured" end) else "status unavailable" end')"
  printf '  artifacts   %s publishable · %s excluded · %s total\n' \
    "$(printf '%s' "$result" | jq -r '.artifacts.publishable|length')" \
    "$(printf '%s' "$result" | jq -r '.artifacts.excluded|length')" \
    "$(printf '%s' "$result" | jq -r '.artifacts.total')"
  printf '  agent home  %s\n' "$agent_home"

  if [ "$(printf '%s' "$result" | jq -r '.artifacts.excluded|length')" -gt 0 ]; then
    printf '\nExclusions:\n'
    printf '%s' "$result" | jq -r '.artifacts.exclusions | to_entries[] | "  \(.key)\t\(.value)"'
  fi
  printf '\nRead-only status complete. No Linear mutations were attempted.\n'
}

command="${1:-status}"
[ $# -eq 0 ] || shift
case "$command" in
  status) status_command "$@" ;;
  issues) issues_command "$@" ;;
  reconcile|inbox)
    script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    exec "$script_dir/bdx-linear-reconcile" "$command" "$@"
    ;;
  -h|--help|help) usage ;;
  *) usage; die "unknown command: $command" ;;
esac

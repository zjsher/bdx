#!/bin/bash
# bdx-note — append one timestamped line to a bd's plan file.
#
# The cheap primitive for "I just learned something." Narrative belongs in the
# plan, not in bd's --notes/--design blobs (which no tool reads and which can't
# be edited in place). This is one command, no skill load, no ceremony.
#
# Usage:
#   bdx-note "text"                 # bd-id from $BD_ID, or the sole in_progress bd
#   bdx-note bd-abc "text"          # explicit bd-id
#   bdx-note -q bd-abc "text"       # quiet: print nothing on success
#
# Writes to the `## Log` section of $AGENT_HOME/plan/<bd-id>-*.md, creating the
# section if it doesn't exist yet.
#
# Related: `bd comment` is still the right call for *pointers* (summary/context
# paths, progress echoes) — attach reads those back at boot. This is for the
# narrative that a future attach needs in the plan itself.

set -u

QUIET=0

usage() {
  cat >&2 <<'EOF'
usage: bdx-note [-q] [bd-id] "<text>"

  bdx-note "found the leak in the retry loop"
  bdx-note bd-abc "found the leak in the retry loop"

Appends a timestamped line to the ## Log section of the bd's plan file.
bd-id defaults to $BD_ID, then to the only in_progress bd that has a plan.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -q|--quiet) QUIET=1; shift ;;
    -h|--help)  usage; exit 0 ;;
    --)         shift; break ;;
    -*)         echo "bdx-note: unknown flag: $1" >&2; usage; exit 2 ;;
    *)          break ;;
  esac
done

[ $# -ge 1 ] || { usage; exit 2; }

# ---- resolve bd-id -----------------------------------------------------------

BD=""
if printf '%s' "${1:-}" | grep -Eq '^bd-[a-z0-9]+$'; then
  BD="$1"; shift
fi

if [ -z "$BD" ]; then
  BD="${BD_ID:-}"
fi

AGENT_HOME="${AGENT_HOME:-$HOME/.bdx-agent}"
PLAN_DIR="$AGENT_HOME/plan"

if [ -z "$BD" ]; then
  # Fall back to the sole in_progress bd that actually has a plan file.
  CANDIDATES=""
  if command -v bd >/dev/null 2>&1; then
    for id in $(bd list --status=in_progress --json 2>/dev/null | jq -r '.[].id' 2>/dev/null); do
      for f in "$PLAN_DIR/$id"-*.md; do
        [ -e "$f" ] && CANDIDATES="$CANDIDATES $id" && break
      done
    done
  fi
  # Count without touching "$@" — the note text is still sitting in there.
  # shellcheck disable=SC2086 — intentional word-splitting
  CAND_ARR=($CANDIDATES)
  COUNT="${#CAND_ARR[@]}"
  if [ "$COUNT" = "1" ]; then
    BD="${CAND_ARR[0]}"
  else
    echo "bdx-note: no bd-id given and \$BD_ID is unset." >&2
    if [ "$COUNT" != "0" ]; then
      echo "  in_progress bds with plans:$CANDIDATES" >&2
    fi
    echo "  pass one explicitly:  bdx-note bd-abc \"<text>\"" >&2
    exit 2
  fi
fi

[ $# -ge 1 ] || { echo "bdx-note: no text to write." >&2; usage; exit 2; }
TEXT="$*"

# ---- locate the plan file ----------------------------------------------------

MATCHES=()
for f in "$PLAN_DIR/$BD"-*.md; do
  [ -e "$f" ] && MATCHES+=("$f")
done

if [ "${#MATCHES[@]}" -eq 0 ]; then
  echo "bdx-note: no plan file for $BD in $PLAN_DIR" >&2
  echo "  run  /bdx:plan  (new work)  or  /bdx:scope $BD  (existing bare bd)" >&2
  exit 1
fi
if [ "${#MATCHES[@]}" -gt 1 ]; then
  echo "bdx-note: multiple plan files for $BD — expected exactly one:" >&2
  printf '  %s\n' "${MATCHES[@]}" >&2
  exit 1
fi
PLAN="${MATCHES[0]}"

# ---- build the entry ---------------------------------------------------------

STAMP=$(date '+%Y-%m-%d %H:%M')
# Multi-line text stays inside the bullet: continuation lines get indented.
ENTRY=$(printf '%s' "$TEXT" | awk -v stamp="$STAMP" '
  NR == 1 { printf "- %s — %s\n", stamp, $0; next }
  { printf "  %s\n", $0 }
')

# ---- append to ## Log (creating it if absent) --------------------------------

# Coordinate with status/session projection: both are whole-file transforms,
# so they must share the same per-plan lock and same-directory atomic replace.
LOCK_DIR="$PLAN.bdx-lock"
acquired=0
for _attempt in $(seq 1 100); do
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    acquired=1
    printf '%s\n' "$$" > "$LOCK_DIR/pid"
    break
  fi
  sleep 0.05
done
if [ "$acquired" -ne 1 ]; then
  echo "bdx-note: timed out waiting for plan lock: $LOCK_DIR" >&2
  exit 1
fi

TMP=""
cleanup() {
  [ -z "$TMP" ] || rm -f -- "$TMP"
  rm -f -- "$LOCK_DIR/pid"
  rmdir -- "$LOCK_DIR" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

TMP=$(mktemp "${PLAN}.tmp.XXXXXX") || exit 1

# Passed via the environment, not -v: awk's -v can't carry a newline, and a
# note is allowed to be more than one line.
BDX_NOTE_ENTRY="$ENTRY" awk '
  BEGIN { in_log = 0; done = 0; entry = ENVIRON["BDX_NOTE_ENTRY"] }

  # Leaving the ## Log section: flush the entry at its tail.
  in_log && /^## / {
    sub(/\n+$/, "", buf)
    print buf
    print entry
    print ""
    in_log = 0; done = 1
    print; next
  }

  in_log { buf = buf $0 "\n"; next }

  /^## [Ll]og[[:space:]]*$/ { in_log = 1; buf = ""; print; next }

  # No ## Log yet — create it just before ## Related.
  !done && /^## Related[[:space:]]*$/ {
    print "## Log"
    print ""
    print entry
    print ""
    done = 1
    print; next
  }

  { print }

  END {
    if (in_log) {
      sub(/\n+$/, "", buf)
      if (buf != "") print buf
      print entry
    } else if (!done) {
      print ""
      print "## Log"
      print ""
      print entry
    }
  }
' "$PLAN" > "$TMP" || exit 1

chmod --reference="$PLAN" "$TMP" 2>/dev/null || chmod "$(stat -f '%Lp' "$PLAN" 2>/dev/null || stat -c '%a' "$PLAN")" "$TMP"
mv -f -- "$TMP" "$PLAN" || exit 1
TMP=""

[ "$QUIET" = "1" ] || {
  echo "$BD ← $ENTRY"
  echo "  $PLAN"
}
